{
  "name": "ai-playground",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "homepage": "https://mrishab.github.io/ai-playground/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrishab/ai-playground.git"
  },
  "bugs": {
    "url": "https://github.com/mrishab/ai-playground/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && cp dist/index.html dist/404.html 2>/dev/null || true",
    "preview": "vite preview",
    "test": "vitest run",
    "cypress:run": "cypress run --headless --browser electron",
    "cypress:open": "cypress open",
    "doctor": "NODE_OPTIONS=\"--experimental-require-module\" react-doctor -y",
    "knip": "NODE_OPTIONS=\"--experimental-require-module\" knip"
  },
  "dependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/prismjs": "^1.26.6",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "prismjs": "^1.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@cypress/code-coverage": "^4.1.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "cypress": "^15.21.1",
    "jsdom": "^26.0.0",
    "knip": "^6.38.0",
    "postcss": "^8.5.2",
    "react-doctor": "^0.9.14",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-istanbul": "^6.0.2",
    "vitest": "^4.1.12"
  },
  "nyc": {
    "report-dir": "coverage",
    "reporter": [
      "text",
      "text-summary",
      "html",
      "json-summary",
      "lcov"
    ],
    "include": [
      "src/**"
    ],
    "exclude": [
      "coverage/**",
      "cypress/**",
      "src/test/**",
      "**/*.d.ts",
      "**/*Types.ts",
      "**/*types.ts",
      "**/*.css",
      "*.config.*",
      "dist/**"
    ],
    "all": true
  }
}
